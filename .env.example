# ============================================================
# Sistema de Análise de Termos de Referência — Variáveis de Ambiente
# ============================================================
# Copie este arquivo para .env e preencha os valores.
# NÃO commite o arquivo .env no repositório.
# ============================================================

# --- Banco de Dados ---
POSTGRES_USER=sei_user
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
POSTGRES_DB=sei_analise
DATABASE_URL=postgresql+asyncpg://sei_user:CHANGE_ME_TO_A_STRONG_PASSWORD@db:5432/sei_analise

# --- Provedor de LLM ---
# Opções: groq | gemini | ollama
LLM_PROVIDER=groq

# --- Groq (free tier) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Google Gemini (free tier) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Ollama (modelos locais) ---
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:32b

# --- Aplicação ---
BACKEND_PORT=8000
FRONTEND_PORT=3000
ALLOWED_ORIGINS=http://localhost:3000
MAX_UPLOAD_SIZE_MB=50
