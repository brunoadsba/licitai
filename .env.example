# ============================================================
# Sistema de Analise de Termos de Referencia — Variaveis de Ambiente
# ============================================================
# Copie este arquivo para .env e preencha os valores.
# NAO commite o arquivo .env no repositorio.
# ============================================================

# --- Banco de Dados ---
POSTGRES_USER=sei_user
# Mesma senha usada no Compose e na DATABASE_URL abaixo.
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=sei_analise
# Local (host): use 127.0.0.1. Dentro do Compose: host `db`.
DATABASE_URL=postgresql+asyncpg://sei_user:CHANGE_ME@db:5432/sei_analise
# APP_ENV=development|staging|production (fora de development exige API_TOKEN + Postgres)
APP_ENV=development

# --- Provedor de LLM ---
# Opcoes: groq | gemini | ollama
LLM_PROVIDER=groq
# false (padrao): sigiloso ou sem classificacao nao vai para Groq/Gemini.
# true so e aceito com APP_ENV=development. Publico e interno usam nuvem mesmo com false.
LLM_ALLOW_CLOUD=false
# Timeout (segundos) por chamada ao LLM, antes de tentar o failover
LLM_TIMEOUT_SECONDS=120

# --- Groq (free tier) ---
GROQ_API_KEY=
# Modelos atuais (09/09/2026): openai/gpt-oss-20b (Groq) — llama-3.1-8b-instant saiu do catálogo.
# ANALYSIS_CONCURRENCY=1 no Compose reduz 429 TPM no free tier.
# Soft budget de chamadas LLM por análise (0 = ilimitado). Estima 2/item economic, 4/item multi.
# 0 = ilimitado; piloto free tier: 24 (~12 itens no economic)
ANALYSIS_MAX_LLM_CALLS=24
GROQ_MODEL=openai/gpt-oss-20b

# --- RAG moderno (recuperar muito, entregar pouco) ---
# Candidatos por backend antes do rerank; 0 desliga (top_k direto).
# 50 cobre bem o corpus piloto (~600 chunks) com custo trivial de lista.
RAG_CANDIDATES=50
# off = RRF puro (comportamento antigo); heuristic = rerank determinístico (padrão, custo zero);
# llm = heurístico + 2ª passada no LLM (opt-in, +1 chamada/item; sigiloso nunca vai a cloud).
RAG_RERANK_MODE=heuristic
# Teto padrão entregue pelo retrieve() quando o chamador omite top_k.
RAG_TOP_K=5
# 1 = filtra por regime detectado quando não-ambíguo. 0 = sem filtro (padrão).
# Ligar exclui transversal (TCU/AGU/CGU): validar recall antes.
RAG_REGIME_FILTER=0

# --- Google Gemini (free tier) ---
GEMINI_API_KEY=
# Alias Gemini: pin explícito no piloto; evite trocar sem smoke E2E.
# Preferir versão pinada (ex. gemini-2.5-flash) se disponível na conta; alias *-latest só com smoke.
GEMINI_MODEL=gemini-flash-latest

# --- Ollama (modelos locais) ---
# Modelos locais: qwen3:32b (padrão) ou hermes3 (8B, open weights — bom em
# JSON/instruções; útil quando o TR é sigiloso e não pode ir à nuvem).
# Baixe com: ollama pull qwen3:32b  |  ollama pull hermes3
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:32b

# --- Embeddings (RAG v1.0 — busca semantica) ---
# Opcoes: gemini | ollama. O Gemini usa gemini-embedding-001 (mesma GEMINI_API_KEY).
# O Ollama usa um modelo local de embeddings (ex.: bge-m3, dimensao 1024).
EMBEDDINGS_PROVIDER=gemini
EMBEDDINGS_MODEL=gemini-embedding-001
EMBEDDINGS_DIM=3072

# --- Aplicacao ---
BACKEND_PORT=8000
FRONTEND_PORT=3000
ALLOWED_ORIGINS=http://localhost:3000
MAX_UPLOAD_SIZE_MB=50

# --- Seguranca ---
# Obrigatorio com PostgreSQL (Compose/piloto). Vazio so e permitido no SQLite local.
# O frontend injeta o token via BFF server-side — nunca use NEXT_PUBLIC_API_TOKEN.
# Nao e autenticacao multiusuario: e so contenção operacional do piloto.
API_TOKEN=CHANGE_ME_GERE_UM_TOKEN

# --- SMTP (RF04 — envio de pendencias por fornecedor) ---
# Host e remetente sao obrigatorios para habilitar o envio.
# Autenticacao (usuario/senha) e usada quando SMTP_USER estiver preenchido.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Copiloto (chat consultivo) ---
# Habilita/desabilita o chat e o grounding obrigatorio (resposta factual so com citacao).
CHAT_ENABLED=True
CHAT_REQUIRE_GROUNDING=True
# Numero de fontes juridicas recuperadas do RAG por pergunta.
CHAT_TOP_K_SOURCES=5
# Limite de caracteres de uma mensagem do usuario.
CHAT_MAX_MESSAGE_LENGTH=2000
# Limite de fontes armazenadas na resposta do assistente.
CHAT_MAX_SOURCES_STORED=8
# True usa resposta fake deterministica (demo/CI sem chaves de IA).
CHAT_FORCE_FAKE_PROVIDER=False
