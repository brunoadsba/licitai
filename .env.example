# ============================================================
# Sistema de Analise de Termos de Referencia — Variaveis de Ambiente
# ============================================================
# Copie este arquivo para .env e preencha os valores.
# NAO commite o arquivo .env no repositorio.
# ============================================================

# --- Banco de Dados ---
POSTGRES_USER=sei_user
# Mesma senha usada no Compose e na DATABASE_URL abaixo.
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=sei_analise
# Local (host): use 127.0.0.1. Dentro do Compose: host `db`.
DATABASE_URL=postgresql+asyncpg://sei_user:CHANGE_ME@db:5432/sei_analise
# APP_ENV=development|staging|production (fora de development exige API_TOKEN + Postgres)
APP_ENV=development

# --- Provedor de LLM ---
# Opcoes: groq | gemini | ollama
LLM_PROVIDER=groq
# false (padrao): sigiloso ou sem classificacao nao vai para Groq/Gemini.
# true so e aceito com APP_ENV=development. Publico e interno usam nuvem mesmo com false.
# Sigiloso so vai a nuvem com os dois true, e somente em development.
LLM_ALLOW_CLOUD=false
LLM_DEV_CLOUD_OVERRIDE=false
# Timeout (segundos) por chamada ao LLM, antes de tentar o failover
LLM_TIMEOUT_SECONDS=120

# --- Groq (free tier) ---
GROQ_API_KEY=
# Modelos atuais (09/09/2026): openai/gpt-oss-20b (Groq) — llama-3.1-8b-instant saiu do catálogo.
# ANALYSIS_CONCURRENCY=1 no Compose reduz 429 TPM no free tier.
# Soft budget de chamadas LLM por análise (0 = ilimitado). Estima 2/item economic, 4/item multi.
# 0 = ilimitado; piloto free tier: 24 (~12 itens no economic)
ANALYSIS_MAX_LLM_CALLS=24
# Itens por chamada LLM: 1 = 1 call/item (default); 5 = bulk (~5x menos calls/tokens).
ANALYSIS_BATCH_SIZE=1
# Supervisor v1: re-review de altos pendentes (~1 call/lote). False = pula.
SUPERVISOR_REREVIEW_HIGH=true
# Miss-hunter v1: 2ª passada nos itens "ok" (~1 call/lote fora do orçamento).
# Default OFF: ligar só com cota folgada ou fallback pago. Max items = teto de custo.
MISS_HUNTER_ENABLED=false
MISS_HUNTER_MAX_ITEMS=10
GROQ_MODEL=openai/gpt-oss-20b

# --- Provedores free extra (fallback automático; vazio = desligado) ---
# Mistral: console.mistral.ai (free; testado: open-mistral-nemo).
MISTRAL_API_KEY=
MISTRAL_MODEL=open-mistral-nemo
# OpenRouter: openrouter.ai/keys (modelos :free; 50 req/dia, 1000 com crédito).
# O roster :free muda sempre — confira em openrouter.ai/models.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.8-27b:free
# HuggingFace: huggingface.co/settings/tokens (Inference Providers, free com token).
HF_API_KEY=
HF_MODEL=Qwen/Qwen3-8B
# HF_BASE_URL só mude se usar outro endpoint OpenAI-compatível.
HF_BASE_URL=https://router.huggingface.co/v1
# Cohere: dashboard.cohere.com (Trial key, ~100 req/dia non-commercial).
COHERE_API_KEY=
COHERE_MODEL=command-r
# NVIDIA: build.nvidia.com (conta gratuita, chave nvapi-*).
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
# Pollinations: legado sem chave morreu (500); nova API autenticada (enter.pollinations.ai).
POLLINATIONS_API_KEY=
POLLINATIONS_MODEL=openai
POLLINATIONS_BASE_URL=https://text.pollinations.ai/openai
# SiliconFlow: siliconflow.cn (free sem cartão, 1000 RPM).
SILICONFLOW_API_KEY=
SILICONFLOW_MODEL=Qwen/Qwen3-8B
# Z.ai: z.ai (GLM Flash free sem cartão; se pedir top-up, pule p/ DeepSeek).
ZAI_API_KEY=
ZAI_MODEL=glm-4.5-flash
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
# DeepSeek: platform.deepseek.com (5M tokens free no cadastro, sem cartão).
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# LongCat: longcat.ai/platform (OpenAI-compatível; entra com cota).
LONGCAT_API_KEY=
LONGCAT_MODEL=LongCat-2.5-Preview
LONGCAT_BASE_URL=https://api.longcat.chat/openai/v1
# OpenCode Zen: opencode.ai (login + API key; modelos *-free no catálogo).
OPENCODE_API_KEY=
OPENCODE_MODEL=mimo-v2.6-flash-free
OPENCODE_BASE_URL=https://opencode.ai/inference/openai/v1

# --- RAG moderno (recuperar muito, entregar pouco) ---
# Candidatos por backend antes do rerank; 0 desliga (top_k direto).
# 50 cobre bem o corpus piloto (~600 chunks) com custo trivial de lista.
RAG_CANDIDATES=50
# off = RRF puro (comportamento antigo); heuristic = rerank determinístico (padrão, custo zero);
# llm = heurístico + 2ª passada no LLM (opt-in, +1 chamada/item; sigiloso nunca vai a cloud).
RAG_RERANK_MODE=heuristic
# Teto padrão entregue pelo retrieve() quando o chamador omite top_k.
RAG_TOP_K=5
# 1 = filtra por regime detectado quando não-ambíguo. 0 = sem filtro (padrão).
# Ligar exclui transversal (TCU/AGU/CGU): validar recall antes.
RAG_REGIME_FILTER=0

# --- Google Gemini (free tier) ---
GEMINI_API_KEY=
# Alias Gemini: pin explícito no piloto; evite trocar sem smoke E2E.
# Preferir versão pinada (ex. gemini-2.5-flash) se disponível na conta; alias *-latest só com smoke.
GEMINI_MODEL=gemini-flash-latest

# --- Ollama (modelos locais) ---
# Sigiloso usa só este modelo, no host (não há serviço ollama no Compose).
# Baixe com: ollama pull qwen3:8b
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:8b

# --- Embeddings (RAG v1.0 — busca semantica) ---
# Opcoes: gemini | ollama. O Gemini usa gemini-embedding-001 (mesma GEMINI_API_KEY).
# O Ollama usa um modelo local de embeddings (ex.: bge-m3, dimensao 1024).
EMBEDDINGS_PROVIDER=gemini
EMBEDDINGS_MODEL=gemini-embedding-001
EMBEDDINGS_DIM=3072

# --- Aplicacao ---
BACKEND_PORT=8000
FRONTEND_PORT=3000
ALLOWED_ORIGINS=http://localhost:3000
MAX_UPLOAD_SIZE_MB=50

# --- Seguranca ---
# Obrigatorio com PostgreSQL (Compose/piloto). Vazio so e permitido no SQLite local.
# O frontend injeta o token via BFF server-side — nunca use NEXT_PUBLIC_API_TOKEN.
# Nao e autenticacao multiusuario: e so contenção operacional do piloto.
API_TOKEN=CHANGE_ME_GERE_UM_TOKEN
# BFF /api/proxy: origens extras além da mesma origem (ex.: chrome-extension://<id>
# da extensão SEI, que só faz GET). Vazio = só mesma origem. Separadas por vírgula.
BFF_ALLOWED_ORIGINS=

# --- SMTP (RF04 — envio de pendencias por fornecedor) ---
# Host e remetente sao obrigatorios para habilitar o envio.
# Autenticacao (usuario/senha) e usada quando SMTP_USER estiver preenchido.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Copiloto (chat consultivo) ---
# Habilita/desabilita o chat e o grounding obrigatorio (resposta factual so com citacao).
CHAT_ENABLED=True
CHAT_REQUIRE_GROUNDING=True
# Numero de fontes juridicas recuperadas do RAG por pergunta.
CHAT_TOP_K_SOURCES=5
# Limite de caracteres de uma mensagem do usuario.
CHAT_MAX_MESSAGE_LENGTH=2000
# Limite de fontes armazenadas na resposta do assistente.
CHAT_MAX_SOURCES_STORED=8
# True usa resposta fake deterministica (demo/CI sem chaves de IA).
CHAT_FORCE_FAKE_PROVIDER=False
